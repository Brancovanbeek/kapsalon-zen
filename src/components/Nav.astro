---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/diensten', label: 'Diensten' },
  { href: '/producten', label: 'Producten' },
  { href: '/over-ons', label: 'Over ons' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

// Actief als de URL exact overeenkomt, of als het een sub-pagina is (bijv. /diensten/knippen)
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<a href="#main-content" class="skip-link">Naar inhoud springen</a>

<input type="checkbox" id="menu-open" class="menu-toggle" tabindex="-1" aria-hidden="true" />

<header class="site-header">
<nav class="nav" aria-label="Hoofdnavigatie">
  <div class="nav__inner container">
    <a href="/" class="nav__logo" aria-label="Kapsalon Zen — terug naar home">ZEN</a>

    <ul class="nav__links" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav__actions">
      <a href="/contact" class="btn btn-ghost nav__cta">Afspraak maken</a>
      <label for="menu-open" class="nav__hamburger" aria-label="Menu openen" tabindex="0">
        <span class="nav__hamburger-bar"></span>
        <span class="nav__hamburger-bar"></span>
        <span class="nav__hamburger-bar"></span>
      </label>
    </div>
  </div>
</nav>
</header>

<!-- Mobiel menu -->
<div class="mobile-menu">
  <label for="menu-open" class="mobile-menu__close" aria-label="Menu sluiten" tabindex="0">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </label>

  <ul class="mobile-menu__links" role="list">
    {navLinks.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={['mobile-menu__link', { 'mobile-menu__link--active': isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <a href="/contact" class="btn btn-primary mobile-menu__cta">Afspraak maken</a>
</div>

<label for="menu-open" class="mobile-overlay" aria-hidden="true"></label>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1.25rem;
    background: var(--dark);
    color: var(--cream);
    font-size: 0.875rem;
    font-weight: 500;
    transition: top 0s;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .menu-toggle {
    display: none;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav {
    padding: 1rem 0;
    background: rgba(221, 210, 192, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    color: var(--dark);
    flex-shrink: 0;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 2.5rem;
  }

  .nav__link {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--dark);
    position: relative;
    padding: 0.75rem 0 2px;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color var(--transition);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width var(--transition);
  }

  .nav__link:hover::after,
  .nav__link--active::after {
    width: 100%;
  }

  .nav__link--active {
    color: var(--accent);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .nav__cta {
    display: none;
    padding: 0.625rem 1.5rem;
    font-size: 0.8rem;
  }

  .nav__hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
    cursor: pointer;
  }

  .nav__hamburger-bar {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--dark);
  }

  /* Mobiel menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 100vw);
    background: var(--warm-white);
    z-index: 200;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 3rem;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.4s;
  }

  .menu-toggle:checked ~ .mobile-menu {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0s;
  }

  .mobile-menu__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--dark);
    padding: 0.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 3rem;
  }

  .mobile-menu__link {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    color: var(--dark);
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--border);
    display: block;
    transition: color var(--transition), padding-left var(--transition);
  }

  .mobile-menu__link--active {
    color: var(--accent);
  }

  .mobile-menu__link:hover {
    color: var(--accent);
    padding-left: 0.5rem;
  }

  .mobile-menu__cta {
    align-self: flex-start;
  }

  /* Overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(26, 24, 20, 0.5);
    z-index: 190;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    cursor: pointer;
  }

  .menu-toggle:checked ~ .mobile-overlay {
    opacity: 1;
    pointer-events: all;
  }

  @media (min-width: 901px) {
    .nav__links,
    .nav__cta {
      display: flex;
    }

    .nav__hamburger {
      display: none;
    }
  }
</style>
