---
// @ts-nocheck
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, portableTextToHtml, formatPrice, srcset } from '../../lib/sanity.js';

export async function getStaticPaths() {
  // Haal alle producten één keer op uit Sanity
  const products = await getAllProducts().catch(() => []);

  // Maak voor elk product een aparte pagina aan (bijv. /producten/kerastase-shampoo)
  return products.map(product => ({
    params: { slug: product.slug },
    props: {
      product,
      // Gerelateerde producten: zelfde categorie, niet het product zelf, max 3
      related: products
        .filter(p => p.category === product.category && p.slug !== product.slug)
        .slice(0, 3),
    },
  }));
}

const { product, related } = Astro.props;
---

<BaseLayout
  title={product.title}
  description={product.shortDescription ?? `${product.title} — verkrijgbaar bij Kapsalon Zen`}
  ogImage={product.imageUrl ?? undefined}
>

  <main class="product-page">
    <div class="container back-link-wrap">
      <a href="/producten" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Alle producten
      </a>
    </div>

    <div class="container product-page__inner">
      <div class="product-gallery fade-in">
        <div class="product-gallery__main">
          {product.imageUrl ? (
            <img
              src={`${product.imageUrl}?w=900&auto=format`}
              srcset={srcset(product.imageUrl, [400, 800, 1200, 1800])}
              sizes="(min-width: 900px) 50vw, 100vw"
              alt={product.imageAlt ?? product.title}
              width="900"
              height="900"
              loading="eager"
              class="product-gallery__main-img"
            />
          ) : (
            <div class="product-gallery__main-img product-gallery__placeholder"></div>
          )}
        </div>

        {product.galleryImages?.length > 0 && (
          <div class="product-gallery__thumbs">
            {product.galleryImages.map((img) => (
              <a href={`${img.url}?auto=format`} target="_blank" rel="noopener" class="thumb" aria-label={img.alt ?? product.title}>
                <img
                  src={`${img.url}?w=150&auto=format`}
                  srcset={`${img.url}?w=72&auto=format 72w, ${img.url}?w=150&auto=format 150w`}
                  sizes="72px"
                  alt={img.alt ?? product.title}
                  width="80"
                  height="80"
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="product-info">
        {product.brand && (
          <p class="product-info__brand label fade-in">{product.brand}</p>
        )}

        <h1 class="product-info__title fade-in fade-in-delay-1">{product.title}</h1>

        <p class="product-info__price fade-in fade-in-delay-1">{formatPrice(product.price)}</p>

        {product.shortDescription && (
          <p class="product-info__short-desc fade-in fade-in-delay-2">{product.shortDescription}</p>
        )}

        <div class="fade-in fade-in-delay-2">
          {product.inStock ? (
            <span class="badge badge-in-stock">
              <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true"><circle cx="4" cy="4" r="4" fill="currentColor"/></svg>
              Op voorraad
            </span>
          ) : (
            <span class="badge badge-out-of-stock">
              <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true"><circle cx="4" cy="4" r="4" fill="currentColor"/></svg>
              Uitverkocht
            </span>
          )}
        </div>

        {product.description?.length > 0 && (
          <div
            class="product-info__body prose fade-in fade-in-delay-3"
            set:html={portableTextToHtml(product.description)}
          />
        )}

        <div class="product-info__salon-note fade-in fade-in-delay-3">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"></path>
            <circle cx="12" cy="9" r="2.5"></circle>
          </svg>
          <span>
            <strong>Verkrijgbaar in de salon</strong><br />
            Siriusplein 1, Volendam
          </span>
        </div>
      </div>
    </div>

    <!-- Related products -->
    {related.length > 0 && (
      <section class="related section">
        <div class="container">
          <div class="section-header">
            <span class="label">In dezelfde categorie</span>
            <h2 class="fade-in">Gerelateerde producten</h2>
          </div>
          <div class="grid-3">
            {related.map((p, i) => (
              <div class={`fade-in fade-in-delay-${i + 1}`}>
                <ProductCard
                  title={p.title}
                  slug={p.slug}
                  brand={p.brand}
                  price={p.price}
                  imageUrl={p.imageUrl}
                  imageAlt={p.imageAlt}
                  inStock={p.inStock}
                  category={p.category}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
