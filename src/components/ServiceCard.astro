---
import { srcset } from '../lib/sanity.js';

const { title, slug, shortDescription, price, number, imageUrl, imageAlt } = Astro.props;
---

<article class="service-card">
  <div class="service-card__inner">
    <span class="service-card__number label">{number}</span>

    {imageUrl
      ? <div class="service-card__image">
          <img
            src={`${imageUrl}?w=800&auto=format`}
            srcset={srcset(imageUrl)}
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            alt={imageAlt ?? title}
            loading="lazy"
            width="400"
            height="300"
          />
        </div>
      : <div class="service-card__image service-card__image--placeholder"></div>
    }

    <div class="service-card__body">
      <h3 class="service-card__title">{title}</h3>
      {shortDescription && <p class="service-card__desc">{shortDescription}</p>}
      <div class="service-card__footer">
        <span class="service-card__price">{price}</span>
        <a href={`/diensten/${slug}`} class="arrow-link">
          Meer info
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>
