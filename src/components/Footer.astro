---
import { getSiteSettings } from '../lib/sanity.js';

const settings  = await getSiteSettings();
const salonName = settings?.salonName ?? 'Kapsalon Zen';
const phone     = settings?.phone     ?? '0640181876';
const email     = settings?.email     ?? 'jcmbuijs@ziggo.nl';
const address   = settings?.address   ?? 'Siriusplein 1, Volendam';
const instagram = settings?.instagram ?? '#';
const facebook  = settings?.facebook  ?? '#';
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo">ZEN</a>
      <p class="footer__tagline">{settings?.tagline ?? 'Uw lokale kapsalon voor knippen, kleuren en haarverzorging.'}</p>
      <div class="footer__socials">
        <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h4 class="footer__heading">Navigatie</h4>
      <ul class="footer__nav">
        <li><a href="/">Home</a></li>
        <li><a href="/diensten">Diensten</a></li>
        <li><a href="/producten">Producten</a></li>
        <li><a href="/over-ons">Over ons</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="footer__heading">Contact</h4>
      <address class="footer__address">
        <p>{address}</p>
        <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
      </address>
    </div>

    <div class="footer__col">
      <h4 class="footer__heading">Openingstijden</h4>
      <ul class="footer__hours">
        <li><span>Ma – Za</span><span>Op afspraak</span></li>
        <li><span>Zondag</span><span>Gesloten</span></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; {new Date().getFullYear()} {salonName}. Alle rechten voorbehouden.</p>
      <p>Gemaakt door Branco van Beek.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--cream);
    padding-top: 5rem;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(245, 240, 232, 0.1);
  }

  /* Brand */
  .footer__logo {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    color: var(--cream);
    display: block;
    margin-bottom: 1rem;
  }

  .footer__tagline {
    font-size: 0.875rem;
    color: rgba(245, 240, 232, 0.6);
    line-height: 1.6;
    max-width: 260px;
    margin-bottom: 1.5rem;
  }

  .footer__socials {
    display: flex;
    gap: 1rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(245, 240, 232, 0.2);
    border-radius: 50%;
    color: var(--cream);
    transition: border-color var(--transition), color var(--transition);
  }

  .footer__social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Columns */
  .footer__heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.5);
    margin-bottom: 1.25rem;
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer__nav a {
    font-size: 0.9rem;
    color: rgba(245, 240, 232, 0.75);
    transition: color var(--transition);
  }

  .footer__nav a:hover {
    color: var(--accent);
  }

  /* Address */
  .footer__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: rgba(245, 240, 232, 0.75);
  }

  .footer__address a {
    transition: color var(--transition);
  }

  .footer__address a:hover {
    color: var(--accent);
  }

  /* Hours */
  .footer__hours {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__hours li {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: rgba(245, 240, 232, 0.75);
  }

  /* Bottom bar */
  .footer__bottom {
    padding: 1.5rem 0;
  }

  .footer__bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    align-items: center;
    font-size: 0.8rem;
    color: rgba(245, 240, 232, 0.4);
  }

  /* Responsive */
  @media (min-width: 601px) {
    .footer__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    .footer__bottom-inner {
      flex-direction: row;
      text-align: left;
      justify-content: space-between;
    }
  }

  @media (min-width: 1025px) {
    .footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }
</style>
