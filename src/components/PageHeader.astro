---
const { 
  label, 
  title, 
  sub 
} = Astro.props;
---

<header class="page-header">
  <div class="container">
    <span class="label fade-in">{label}</span>
    <h1 class="page-header__title fade-in fade-in-delay-1">{title}</h1>
    <p class="page-header__sub fade-in fade-in-delay-2">{sub}</p>
  </div>
</header>
