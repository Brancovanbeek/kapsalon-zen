---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  getHomePage,
  getFeaturedServices,
  getFeaturedProducts,
  getAllTestimonials,
  srcset,
} from '../lib/sanity.js';

const homePage         = await getHomePage().catch(() => null);
const featuredServices = await getFeaturedServices().catch(() => []);
const featuredProducts = await getFeaturedProducts().catch(() => []);
const testimonials     = await getAllTestimonials().catch(() => []);

const heroHeadline = homePage?.heroHeadline ?? 'Vakmanschap voor uw haar';
const heroSubtext  = homePage?.heroSubtext  ?? 'Bij Kapsalon Zen combineren we ambacht met persoonlijke aandacht. Welkom in een plek van rust en kwaliteit.';
const heroImages   = homePage?.heroImages   ?? [];
const aboutHeading = homePage?.aboutHeading ?? 'Een plek van rust en vakmanschap';
const aboutText    = homePage?.aboutText    ?? 'Al meer dan twaalf jaar verwelkomen wij onze gasten in een sfeervolle en rustige omgeving. Wij geloven in persoonlijke aandacht, kwaliteitsproducten en een resultaat waar u blij van wordt.';

const displayTestimonials = testimonials.slice(0, 3);
---

<BaseLayout
  title="Kapsalon Zen - Vakmanschap voor uw haar"
  description={heroSubtext}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="label hero__label fade-in">Jouw lokale kapsalon</span>
        <h1 class="hero__headline fade-in fade-in-delay-1">{heroHeadline}</h1>
        <p class="hero__subtext fade-in fade-in-delay-2">{heroSubtext}</p>
        <div class="hero__actions fade-in fade-in-delay-3">
          <a href="/contact" class="btn btn-primary">Afspraak maken</a>
          <a href="/diensten" class="btn btn-ghost">Bekijk diensten</a>
        </div>
      </div>

      <div class="hero__images">
        {heroImages.length > 0
          ? heroImages.slice(0, 4).map((img: any, i: number) => (
              <div class={`hero__image-cell hero__image-cell--${i + 1}`}>
                <img
                  src={`${img.imageUrl}?w=800&auto=format`}
                  srcset={srcset(img.imageUrl)}
                  sizes="(min-width: 1024px) 25vw, 50vw"
                  alt={img.alt ?? `Kapsalon Zen — sfeerfoto ${i + 1}`}
                  loading="eager"
                  width="350"
                  height="450"
                />
              </div>
            ))
          : [1, 2, 3, 4].map((n) => (
              <div class={`hero__image-cell hero__image-cell--${n} hero__image-cell--placeholder`}></div>
            ))
        }
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about section">
    <div class="container about__inner">
      <div class="about__image-wrap fade-in">
        {homePage?.aboutImageUrl
          ? (
              <img
                src={`${homePage.aboutImageUrl}?w=800&auto=format`}
                srcset={srcset(homePage.aboutImageUrl)}
                sizes="(min-width: 1024px) 50vw, 100vw"
                alt={homePage.aboutImageAlt ?? 'Over Kapsalon Zen'}
                loading="lazy"
                width="400"
                height="550"
                class="about__image"
              />
            )
          : (
              <div class="about__image about__image--placeholder"></div>
            )
        }
      </div>

      <div class="about__content">
        <span class="label fade-in">Over ons</span>
        <h2 class="about__heading fade-in fade-in-delay-1">{aboutHeading}</h2>
        <div class="divider fade-in fade-in-delay-1"></div>
        <p class="about__text fade-in fade-in-delay-2">{aboutText}</p>
        <a href="/over-ons" class="arrow-link fade-in fade-in-delay-3">
          Meer over ons
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  
  <!-- SERVICES -->
  <section class="services-section section">
    <div class="container">
      <div class="products-section__header">
        <div>
          <span class="label fade-in">Wat wij doen</span>
          <h2 class="fade-in fade-in-delay-1">Onze diensten</h2>
        </div>
        <a href="/diensten" class="arrow-link fade-in">
          Alle diensten bekijken
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="grid-3">
        {featuredServices.slice(0, 3).map((service, i) => (
          <div class={`fade-in fade-in-delay-${i + 1}`}>
            <ServiceCard
              title={service.title}
              slug={service.slug}
              shortDescription={service.shortDescription}
              price={service.price}
              imageUrl={service.imageUrl}
              imageAlt={service.imageAlt}
              number={String(i + 1).padStart(2, '0')}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS BAR --> 
  <div class="stats-bar">
    <div class="container stats-bar__inner">
      <div class="stat fade-in">
        <span class="stat__number">20+</span>
        <span class="stat__label">jaar ervaring</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat fade-in fade-in-delay-1">
        <span class="stat__number">500+</span>
        <span class="stat__label">tevreden klanten</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat fade-in fade-in-delay-2">
        <span class="stat__number">1</span>
        <span class="stat__label">locatie</span>
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  /*  Hero */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 7rem 0 4rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero__label {
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero__headline {
    font-family: var(--font-heading);
    font-weight: 300;
    line-height: 1.08;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero__subtext {
    font-size: 1rem;
    color: var(--muted);
    max-width: 460px;
    margin-bottom: 2.5rem;
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Hero image grid */
  .hero__images {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 0.75rem;
    height: 400px;
  }

  .hero__image-cell {
    overflow: hidden;
  }

  .hero__image-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__image-cell--1 {
    grid-row: 1;
    grid-column: 1;
  }

  .hero__image-cell--2 {
    grid-row: 1;
    grid-column: 2;
  }

  .hero__image-cell--3 {
    grid-row: 2;
    grid-column: 1;
  }

  .hero__image-cell--4 {
    grid-row: 2;
    grid-column: 2;
  }

  .hero__image-cell--placeholder {
    background: var(--cream);
  }

  /* About */
  .about__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .about__image-wrap {
    position: relative;
  }

  .about__image {
    width: 100%;
    height: 580px;
    object-fit: cover;
  }

  .about__image--placeholder {
    width: 100%;
    height: 580px;
    background: var(--cream);
  }

  .about__content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .about__content .label {
    margin-bottom: 1rem;
  }

  .about__heading {
    margin-bottom: 0;
  }

  .about__text {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

