---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllProducts } from '../lib/sanity.js';

const products = await getAllProducts().catch(() => []);

const categories = [
  { value: 'alle', label: 'Alle' },
  { value: 'shampoo', label: 'Shampoo' },
  { value: 'conditioner', label: 'Conditioner' },
  { value: 'styling', label: 'Styling' },
  { value: 'treatment', label: 'Treatment' },
  { value: 'overig', label: 'Overig' },
];

---

<BaseLayout
  title="Producten"
  description="Ontdek onze collectie professionele haarverzorgingsproducten — verkrijgbaar in de salon."
>

  <main>
    <PageHeader
      label="Ons assortiment"
      title="Producten"
      sub="Professionele haarverzorging om thuis dezelfde kwaliteit te bereiken als in de salon."
    />

    <section class="section">
      <div class="container">
        <nav class="filter-bar fade-in" aria-label="Filteren op categorie">
          {categories.map((c) => (
            <a
              href={c.value === 'alle' ? '/producten' : `/producten?cat=${c.value}`}
              class="filter-btn"
              data-cat={c.value}
            >
              {c.label}
            </a>
          ))}
        </nav>

        {products.length > 0 ? (
          <div class="product-grid" id="product-grid">
            {products.map((product, i) => (
              <div
                class={`fade-in fade-in-delay-${Math.min((i % 3) + 1, 4)}`}
                data-category={product.category}
              >
                <ProductCard
                  title={product.title}
                  slug={product.slug}
                  brand={product.brand}
                  price={product.price}
                  imageUrl={product.imageUrl}
                  imageAlt={product.imageAlt}
                  inStock={product.inStock}
                  category={product.category}
                />
              </div>
            ))}
          </div>
          <p class="empty-state" id="no-results" hidden>Geen producten gevonden in deze categorie.</p>
        ) : (
          <p class="empty-state">Nog geen producten toegevoegd. Voeg producten toe via Sanity Studio.</p>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // @ts-nocheck

  // Lees de actieve categorie uit de URL, standaard 'alle'
  const cat = new URLSearchParams(location.search).get('cat') ?? 'alle';

  // Markeer de juiste filterknop als actief
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.classList.toggle('filter-btn--active', btn.dataset.cat === cat);
  });

  // Verberg kaarten die niet bij de gekozen categorie horen
  if (cat !== 'alle') {
    let visible = 0;
    document.querySelectorAll('#product-grid [data-category]').forEach(card => {
      const show = card.dataset.category === cat;
      card.hidden = !show;
      if (show) visible++;
    });

    // 'geen resultaten' melding als er niets overblijft
    const noResults = document.getElementById('no-results');
    if (noResults) noResults.hidden = visible !== 0;
  }
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .filter-btn {
    padding: 0.5rem 1.25rem;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    color: var(--muted);
    transition: all var(--transition);
  }

  .filter-btn:hover,
  .filter-btn--active {
    background: var(--dark);
    color: var(--cream);
    border-color: var(--dark);
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 501px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 901px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
