---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSiteSettings } from '../lib/sanity.js';

const settings = await getSiteSettings().catch(() => null);
---

<BaseLayout
  title="Over ons"
  description="Ontdek het verhaal achter Kapsalon Zen — onze waarden en onze passie voor haar."
>

  <main>
    <PageHeader
      label="Ons verhaal"
      title="Over Kapsalon Zen"
      sub={settings?.tagline ?? 'Een plek van vakmanschap, rust en persoonlijke aandacht.'}
    />

    <!-- Intro section -->
    <section class="intro section">
      <div class="container intro__inner">
        <div class="intro__content">
          <span class="label fade-in">Wie ik ben</span>
          <h2 class="fade-in fade-in-delay-1">Meer dan een kapsalon</h2>
          <div class="divider fade-in fade-in-delay-1"></div>
          <p class="fade-in fade-in-delay-2">
            Kapsalon Zen is opgericht vanuit een simpele overtuiging: een bezoek aan de kapper moet een moment van rust en zelfzorg zijn. Ik combineer jarenlange expertise met een warme, persoonlijke benadering. Als eenvrouwszaak krijgt u altijd mijn volledige aandacht.
          </p>
          <p class="fade-in fade-in-delay-2">
            Ik werk met geselecteerde professionele producten, volg de nieuwste trends en technieken, maar blijf altijd trouw aan wat u het mooist staat, niet wat op dit moment populair is.
          </p>
        </div>
        <div class="intro__stats fade-in fade-in-delay-3">
          <div class="intro-stat">
            <span class="intro-stat__number">20+</span>
            <span class="intro-stat__label">Jaar ervaring</span>
          </div>
          <div class="intro-stat">
            <span class="intro-stat__number">500+</span>
            <span class="intro-stat__label">Tevreden klanten</span>
          </div>
          <div class="intro-stat">
            <span class="intro-stat__number">100%</span>
            <span class="intro-stat__label">Met hart & ziel</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Values section -->
    <section class="values section">
      <div class="container">
        <div class="section-header">
          <span class="label fade-in">Waar we voor staan</span>
          <h2 class="fade-in fade-in-delay-1">Onze kernwaarden</h2>
        </div>
        <div class="values__grid">
          <div class="value-card fade-in fade-in-delay-1">
            <span class="value-card__icon" aria-hidden="true">◈</span>
            <h3 class="value-card__title">Kwaliteit</h3>
            <p class="value-card__desc">Ik werk uitsluitend met professionele producten die goed presteren en uw haar in de beste conditie houden.</p>
          </div>
          <div class="value-card fade-in fade-in-delay-2">
            <span class="value-card__icon" aria-hidden="true">◎</span>
            <h3 class="value-card__title">Rust</h3>
            <p class="value-card__desc">De salon is ontworpen als een plek van ontspanning. U komt binnen als gast en vertrekt als uzelf.</p>
          </div>
          <div class="value-card fade-in fade-in-delay-3">
            <span class="value-card__icon" aria-hidden="true">◇</span>
            <h3 class="value-card__title">Vakmanschap</h3>
            <p class="value-card__desc">Elk kapsel is maatwerk. Ik luister naar u, adviseer eerlijk en werk met precisie aan het resultaat.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <div class="container cta-banner__inner">
        <div class="fade-in">
          <span class="label">Maak kennis</span>
          <h2 class="cta-banner__heading">Kom langs en ervaar het zelf</h2>
          <p class="cta-banner__sub">Plan een afspraak en ontdek wat ik voor u kan betekenen.</p>
        </div>
        <a href="/contact" class="btn btn-ghost-light fade-in fade-in-delay-1">Afspraak maken</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Intro */
  .intro__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .intro__content p {
    color: var(--muted);
    line-height: 1.8;
  }

  .intro__content p + p {
    margin-top: 1rem;
  }

  .intro__content .label {
    display: block;
    margin-bottom: 1rem;
  }

  .intro__content h2 {
    margin-bottom: 0;
  }

  .intro__stats {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .intro-stat__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 300;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 0.375rem;
  }

  .intro-stat__label {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Values */
  .values__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .value-card {
    padding: 2.5rem 2rem;
    background: var(--warm-white);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .value-card__icon {
    font-size: 1.5rem;
    color: var(--accent);
    line-height: 1;
  }

  .value-card__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 300;
  }

  .value-card__desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.75;
  }

  /* Values section */
  .values {
    background: var(--cream);
  }

  /* Responsive */
  @media (min-width: 769px) {
    .values__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .intro__inner {
      grid-template-columns: 1.4fr 1fr;
      gap: 5rem;
    }

    .intro__stats {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 2rem;
      padding-top: 0;
      padding-left: 3rem;
      border-top: none;
      border-left: 1px solid var(--border);
    }
  }
</style>
