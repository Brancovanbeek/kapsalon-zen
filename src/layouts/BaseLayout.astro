---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/sanity.js';
import '@fontsource-variable/dm-sans/wght.css';

const {
  title,
  description = 'Kapsalon Zen — uw lokale kapsalon voor knippen, kleuren en haarverzorging.',
  ogImage = '',
} = Astro.props;

const fullTitle = title ? `${title} | Kapsalon Zen` : 'Kapsalon Zen';
const settings = await getSiteSettings().catch(() => null);
const siteUrl = Astro.site?.origin ?? 'https://kapsalonzenvolendam.nl';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#DDD2C0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HairSalon',
      name: settings?.salonName ?? 'Kapsalon Zen',
      url: siteUrl,
      telephone: settings?.phone ?? '+31640181876',
      email: settings?.email ?? 'jcmbuijs@ziggo.nl',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Siriusplein 1',
        addressLocality: 'Volendam',
        addressRegion: 'Noord-Holland',
        addressCountry: 'NL',
      },
      currenciesAccepted: 'EUR',
      priceRange: '€€',
    })} />
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <div id="main-content" tabindex="-1" style="outline: none;"></div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
