---
import { formatPrice, srcset } from '../lib/sanity.js';

const { 
  title, 
  slug, 
  brand, 
  price, 
  imageUrl, 
  imageAlt, 
  inStock, 
  category 
  } = Astro.props;
---

<article class="product-card" data-category={category}>
  <a href={`/producten/${slug}`} class="product-card__link" tabindex="-1" aria-hidden="true">
    <div class="product-card__image-wrap">
      {imageUrl ? (
        <img
          src={`${imageUrl}?w=600&auto=format`}
          srcset={srcset(imageUrl)}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          alt={imageAlt ?? title}
          class="product-card__image"
          loading="lazy"
          width="600"
          height="600"
        />
      ) : (
        <div class="product-card__image product-card__image--placeholder"></div>
      )}

      {!inStock && (
        <div class="product-card__sold-out" aria-label="Uitverkocht">Uitverkocht</div>
      )}
    </div>
  </a>

  <div class="product-card__body">
    {brand && <p class="product-card__brand label">{brand}</p>}
    <h3 class="product-card__title">
      <a href={`/producten/${slug}`} class="product-card__title-link">{title}</a>
    </h3>
    <p class="product-card__price">{formatPrice(price)}</p>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
  }

  .product-card__link {
    display: block;
    overflow: hidden;
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--cream);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__image--placeholder {
    width: 100%;
    height: 100%;
    background: var(--cream);
  }

  .product-card__sold-out {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(26, 24, 20, 0.65);
    color: var(--cream);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    backdrop-filter: blur(4px);
  }

  .product-card__body {
    padding: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .product-card__brand {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin-bottom: 0.125rem;
  }

  .product-card__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.3;
  }

  .product-card__title-link {
    color: var(--dark);
    transition: color var(--transition);
    border-bottom: 1px solid transparent;
  }

  .product-card:hover .product-card__title-link {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .product-card__price {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--muted);
  }
</style>
