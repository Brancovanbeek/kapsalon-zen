---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/diensten', label: 'Diensten' },
  { href: '/producten', label: 'Producten' },
  { href: '/over-ons', label: 'Over ons' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

// Actief als de URL exact overeenkomt, of als het een sub-pagina is (bijv. /diensten/knippen)
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<input type="checkbox" id="menu-open" class="menu-toggle" aria-hidden="true" />

<nav class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo" aria-label="Kapsalon Zen — terug naar home">ZEN</a>

    <ul class="nav__links" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--active': isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav__actions">
      <a href="/contact" class="btn btn-ghost nav__cta">Afspraak maken</a>
      <label for="menu-open" class="nav__hamburger" aria-label="Menu openen" tabindex="0">
        <span class="nav__hamburger-bar"></span>
        <span class="nav__hamburger-bar"></span>
        <span class="nav__hamburger-bar"></span>
      </label>
    </div>
  </div>
</nav>

<!-- Mobiel menu -->
<div class="mobile-menu">
  <label for="menu-open" class="mobile-menu__close" aria-label="Menu sluiten">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </label>

  <ul class="mobile-menu__links" role="list">
    {navLinks.map((link) => (
      <li>
        <a href={link.href} class="mobile-menu__link">{link.label}</a>
      </li>
    ))}
  </ul>

  <a href="/contact" class="btn btn-primary mobile-menu__cta">Afspraak maken</a>
</div>

<label for="menu-open" class="mobile-overlay" aria-hidden="true"></label>

