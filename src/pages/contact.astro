---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSiteSettings } from '../lib/sanity.js';

const settings = await getSiteSettings().catch(() => null);

const salonName = settings?.salonName ?? 'Kapsalon Zen';
const phone     = settings?.phone     ?? '0640181876';
const email     = settings?.email     ?? 'jcmbuijs@ziggo.nl';
const address   = settings?.address   ?? 'Siriusplein 1, Volendam';
const instagram = settings?.instagram ?? '#';
const facebook  = settings?.facebook  ?? 'https://www.facebook.com/p/Kapsalon-zen-volendam-100039504776232/';
---

<BaseLayout
  title="Contact"
  description={`Neem contact op met ${salonName} of maak direct een afspraak.`}
>

  <main>
    <PageHeader
      label="Wij zijn er voor u"
      title="Contact"
      sub="Heeft u een vraag of wilt u een afspraak maken? Neem gerust contact op."
    />

    <section class="contact-section section">
      <div class="container contact-section__inner">

        <!-- Left: Contact info -->
        <div class="contact-info">
          <div class="contact-info__block fade-in">
            <h3 class="contact-info__heading">Adres</h3>
            <address class="contact-info__text">{address}</address>
          </div>

          <div class="contact-info__block fade-in fade-in-delay-1">
            <h3 class="contact-info__heading">Bereikbaarheid</h3>
            <div class="contact-info__text">
              <a href={`tel:${phone.replace(/\s/g, '')}`} class="contact-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                {phone}
              </a>
              <a href={`mailto:${email}`} class="contact-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                {email}
              </a>
            </div>
          </div>

          <div class="contact-info__block fade-in fade-in-delay-2">
            <h3 class="contact-info__heading">Openingstijden</h3>
            <table class="hours-table">
              <tbody>
                <tr><td>Maandag – Zaterdag</td><td>Op afspraak</td></tr>
                <tr class="closed"><td>Zondag</td><td>Gesloten</td></tr>
              </tbody>
            </table>
          </div>

          <div class="contact-info__block fade-in fade-in-delay-3">
            <h3 class="contact-info__heading">Volg ons</h3>
            <div class="social-links">
              {instagram && instagram !== '#' && (
                <a href={instagram} target="_blank" rel="noopener noreferrer" class="social-link">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                  Instagram
                </a>
              )}
              {facebook && facebook !== '#' && (
                <a href={facebook} target="_blank" rel="noopener noreferrer" class="social-link">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                  Facebook
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Right: Contact form -->
        <div class="contact-form-wrap fade-in fade-in-delay-1">
          <h2 class="contact-form-wrap__heading">Stuur een bericht</h2>
          <p class="contact-form-wrap__sub">
            Wij reageren zo snel mogelijk, doorgaans binnen één werkdag.
          </p>

          <form class="contact-form" id="contact-form" action="https://formspree.io/f/mykvgzay" method="POST">
            <div class="form-group">
              <label class="form-label" for="name">Naam <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                required
                autocomplete="name"
                placeholder="Uw volledige naam"
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="email">E-mailadres <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                required
                autocomplete="email"
                placeholder="uw@email.nl"
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="phone">Telefoonnummer</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-input"
                autocomplete="tel"
                placeholder="+31 6 00 00 00 00"
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Bericht <span aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                class="form-input form-textarea"
                required
                rows="5"
                placeholder="Beschrijf uw vraag of wens..."
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary form-submit" id="form-btn">
              <span class="form-btn__label">Bericht verzenden</span>
              <svg class="form-btn__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <p class="form-success" id="form-success" hidden aria-live="polite">
              ✓ Bericht verzonden — wij nemen zo snel mogelijk contact op.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Contact layout */
  .contact-section__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Contact info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-info__heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.875rem;
  }

  .contact-info__text {
    font-style: normal;
    font-size: 0.95rem;
    color: var(--dark);
    white-space: pre-line;
    line-height: 1.7;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.95rem;
    color: var(--dark);
    transition: color var(--transition);
    margin-bottom: 0.5rem;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  /* Hours table */
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .hours-table td {
    padding: 0.35rem 0;
    color: var(--dark);
  }

  .hours-table td:last-child {
    text-align: right;
    color: var(--muted);
  }

  .hours-table tr.closed td {
    color: var(--muted);
  }

  /* Social links */
  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9rem;
    color: var(--dark);
    transition: color var(--transition);
  }

  .social-link:hover {
    color: var(--accent);
  }

  /* Form */
  .contact-form-wrap {
    background: var(--cream);
    padding: 2rem 1.5rem;
    border: 1px solid var(--border);
  }

  .contact-form-wrap__heading {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
  }

  .contact-form-wrap__sub {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dark);
  }

  .form-label span {
    color: var(--accent);
  }

  .form-input {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    background: var(--warm-white);
    color: var(--dark);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 300;
    transition: border-color var(--transition);
    -webkit-appearance: none;
    appearance: none;
    border-radius: 0;
  }

  .form-input:focus {
    border-color: var(--dark);
  }

  .form-input::placeholder {
    color: var(--muted);
    opacity: 0.7;
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-submit {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  [hidden] {
    display: none !important;
  }

  .form-success {
    color: var(--accent);
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  /* Responsive */
  @media (min-width: 601px) {
    .contact-form-wrap {
      padding: 3rem;
    }
  }

  @media (min-width: 901px) {
    .contact-section__inner {
      grid-template-columns: 1fr 1.5fr;
      gap: 5rem;
    }
  }
</style>

<script>
  // @ts-nocheck
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('form-btn');
  const label = btn.querySelector('.form-btn__label');
  const success = document.getElementById('form-success');

  form.addEventListener('submit', async (e) => {
    // Voorkom dat de browser de pagina herlaadt bij submit
    e.preventDefault();

    // Zet de knop in loading state
    btn.disabled = true;
    label.textContent = 'Versturen…';

    try {
      // Stuur het formulier naar Formspree via fetch (geen pagina-redirect)
      // Accept: application/json zorgt dat Formspree JSON teruggeeft i.p.v. een HTML-pagina
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        // Succes: formulier leegmaken, knop verbergen, melding tonen
        form.reset();
        btn.hidden = true;
        success.hidden = false;
      } else {
        throw new Error('server error');
      }
    } catch {
      // Fout (netwerk of server): foutmelding tonen en knop heractiveren
      label.textContent = 'Er ging iets mis, probeer het opnieuw';
      btn.disabled = false;
    }
  });
</script>
